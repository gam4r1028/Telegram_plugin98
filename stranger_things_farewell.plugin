class StrangerThingsFarewellPlugin(BasePlugin):
    def __init__(self) -> None:
        super().__init__()
        self.name = "Stranger Things Farewell"
        self.description = "Проводник по сериалу Stranger Things"
        self.version = (1, 1, 0)
        self._menu_text = """
