        }
        self._choice_map: Dict[str, str] = {
            "1": "season1",
            "2": "season2",
            "3": "season3",
            "4": "season4",
            "5": "season5",
            "6": "characters",
            "7": "events",
            "8": "episodes",
            "9": "farewell",
            "10": "facts",
            "11": "music",
            "12": "help",
            "0": "everything",
        }
        self._command_aliases: Dict[str, str] = {
            "0": "everything",
            "1": "season1",
            "10": "facts",
            "11": "music",
            "12": "help",
            "2": "season2",
            "3": "season3",
            "4": "season4",
            "5": "season5",
            "6": "characters",
            "7": "events",
            "8": "episodes",
            "9": "farewell",
            "all": "everything",
            "characters": "characters",
            "episodes": "episodes",
            "events": "events",
            "everything": "everything",
            "facts": "facts",
            "farewell": "farewell",
            "music": "music",
            "overview": "everything",
            "season1": "season1",
            "season2": "season2",
            "season3": "season3",
            "season4": "season4",
            "season5": "season5",
        }
        self._yes_answers = {"да", "да!", "конечно", "разумеется", "ага", "yes", "go"}
        self._no_answers = {"нет", "неа", "не сейчас", "no"}
        self._menu_aliases = {"menu", "меню"}
        self._awaiting_confirmation: Set[int] = set()
        self._active_sessions: Set[int] = set()
        self._skip_outgoing: Set[int] = set()

    def on_load(self) -> Optional[HookResult]:
        return None

    async def on_command(self, client, message, command: str, args) -> Optional[HookResult]:
        normalized = self._normalize_command(command)
        if not normalized:
            return None
        if normalized == "strange":
            await self._handle_start(client, message)
            return None
        if normalized == "stop":
            await self._handle_stop(client, message)
            return None
        if normalized == "menu":
            await self._handle_menu(client, message)
            return None
        if normalized == "help":
            await self._send_help(client, message)
            return None
        topic_key = self._command_aliases.get(normalized)
        if topic_key:
            await self._open_topic(client, message, topic_key)
            return None
        return None

    async def on_text(self, client, message) -> None:
        message_id = getattr(message, "id", None)
        if message_id in self._skip_outgoing:
            self._skip_outgoing.discard(message_id)
            return
        if getattr(message, "out", False):
            return
        text = getattr(message, "raw_text", None)
        if not text:
            return
        chat_id = self._get_chat_id(message)
        if chat_id is None:
            return
        cleaned = text.strip()
        if not cleaned:
            return
        lowered = cleaned.lower()
        if chat_id in self._awaiting_confirmation:
            if lowered in self._yes_answers:
                await self._complete_confirmation(client, message, chat_id)
                return
            if lowered in self._no_answers:
                await self._decline_confirmation(client, message, chat_id)
                return
            await self._send_responses(client, message, ["Не расслышал ответ. Напиши «да», если готов к спойлерам, или «нет», чтобы отложить встречу.\n" + self._spoiler_warning])
            return
        if chat_id not in self._active_sessions:
            return
        if lowered in self._menu_aliases:
            await self._handle_menu(client, message)
            return
        if lowered in self._command_aliases:
            await self._open_topic(client, message, self._command_aliases[lowered])
            return
        if cleaned in self._command_aliases:
            await self._open_topic(client, message, self._command_aliases[cleaned])
            return
        await self._send_responses(client, message, ["Похоже, это воспоминание пока не описано. Используй цифры 0–12, напиши MENU или вызови .help для подсказок."])

    def _normalize_command(self, command: Optional[str]) -> str:
        if not command:
            return ""
        prepared = command.strip()
        if prepared.startswith('.'):
            prepared = prepared[1:]
        return prepared.lower()

    def _get_chat_id(self, message) -> int | None:
        if hasattr(message, "chat_id"):
            return getattr(message, "chat_id")
        if hasattr(message, "peer_id"):
            return getattr(message, "peer_id")
        return None

    async def _handle_start(self, client, message) -> None:
        chat_id = self._get_chat_id(message)
        if chat_id is None:
            return
        self._awaiting_confirmation.add(chat_id)
        self._active_sessions.discard(chat_id)
        await self._send_responses(client, message, [self._start_greeting, self._spoiler_warning])

    async def _handle_stop(self, client, message) -> None:
        chat_id = self._get_chat_id(message)
        if chat_id is None:
            return
        self._awaiting_confirmation.discard(chat_id)
        self._active_sessions.discard(chat_id)
        await self._send_responses(client, message, ["Бот остановлен. Если захочешь вернуться в Хоукинс — напиши .strange."])

    async def _handle_menu(self, client, message) -> None:
        chat_id = self._get_chat_id(message)
        if chat_id is None or chat_id not in self._active_sessions:
            await self._send_responses(client, message, ["Меню доступно после подтверждения спойлеров. Напиши .strange, чтобы начать."])
            return
        await self._send_responses(client, message, [self._menu_header])

    async def _send_help(self, client, message) -> None:
        await self._send_responses(client, message, [self._help_text])

    async def _complete_confirmation(self, client, message, chat_id: int) -> None:
        self._awaiting_confirmation.discard(chat_id)
        self._active_sessions.add(chat_id)
        await self._send_responses(client, message, ["Спасибо, что готов погрузиться в воспоминания!", self._agreement_reply, self._follow_up_reminder])

    async def _decline_confirmation(self, client, message, chat_id: int) -> None:
        self._awaiting_confirmation.discard(chat_id)
        self._active_sessions.discard(chat_id)
        await self._send_responses(client, message, [self._decline_reply])

    async def _open_topic(self, client, message, key: str) -> None:
        if key == "help":
            await self._send_help(client, message)
            return
        chat_id = self._get_chat_id(message)
        if chat_id is None or chat_id not in self._active_sessions:
            if key in ('season1', 'season2', 'season3', 'season4', 'season5', 'characters', 'events', 'episodes', 'facts', 'music', 'farewell', 'everything'):
                await self._send_responses(client, message, ["Сначала напиши .strange и подтверди готовность к спойлерам."])
            return
        text = self._topic_texts.get(key)
        if not text:
            await self._send_responses(client, message, ["Пока нет записей для этого раздела. Попробуй другой пункт меню."])
            return
        await self._send_responses(client, message, [text, self._follow_up_reminder])

    async def _send_responses(self, client, message, responses) -> None:
        if not responses:
            return
        if not isinstance(responses, (list, tuple)):
            responses = [responses]
        jobs: List[str] = []
        for response in responses:
            if not response:
                continue
            for chunk in self._chunk_text(str(response)):
                jobs.append(chunk)
        if not jobs:
            return
        async def runner():
            for chunk in jobs:
                sent = await send_text(client, message, chunk)
                sent_id = getattr(sent, "id", None)
                if sent_id is not None:
                    self._skip_outgoing.add(sent_id)
        try:
            maybe = run_on_queue(runner())
            if maybe is not None:
                await maybe
        except TypeError:
            await runner()
        except RuntimeError:
            await runner()

    def _chunk_text(self, text: str, limit: int = 3500) -> List[str]:
        prepared = text.strip()
        if not prepared:
            return []
        parts = [part.strip() for part in prepared.split("\n\n")]
        parts = [p for p in parts if p]
        if not parts:
            return [prepared]
        chunks: List[str] = []
        buffer = ""
        for part in parts:
            candidate = part if not buffer else buffer + "\n\n" + part
            if len(candidate) <= limit:
                buffer = candidate
                continue
            if buffer:
                chunks.append(buffer)
                buffer = ""
            if len(part) <= limit:
                buffer = part
            else:
                for start in range(0, len(part), limit):
                    piece = part[start:start + limit]
                    if piece:
                        chunks.append(piece)
        if buffer:
            chunks.append(buffer)
        return chunks or [prepared]
